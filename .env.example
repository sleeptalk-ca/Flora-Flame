# ─────────────────────────────────────────────────────────────
# Flora & Flame — environment variables
# Copy to .env.local and fill in. NEVER commit real values.
# Only NEXT_PUBLIC_* variables are exposed to the browser.
# ─────────────────────────────────────────────────────────────

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Data backend ─────────────────────────────────────────────
# "supabase" (production) or "local" (JSON file in ./data, dev/demo only).
# If unset: Supabase is used when SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set.
DATA_BACKEND=

# ── Supabase (server-side only — never prefix with NEXT_PUBLIC_) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Only needed when ADMIN_AUTH_MODE=supabase
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# ── Admin authentication ─────────────────────────────────────
# Random string, 32+ chars:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=

# "env" (default): single admin from the variables below.
# "supabase": Supabase Auth users whose email is listed in ADMIN_EMAILS.
ADMIN_AUTH_MODE=env
ADMIN_EMAIL=
# Set ONE of these. If both are set, the hash wins.
ADMIN_PASSWORD=
# More secure alternative — generate with:  npm run hash-password -- "your strong password"
ADMIN_PASSWORD_HASH=
# Comma-separated allowlist (supabase mode)
ADMIN_EMAILS=
